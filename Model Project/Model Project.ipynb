    "def utility_loss_pct(cls, I, tax_rate):\n",
    "    \"\"\" % utility lost from a lump-sum tax equal to tax_rate*I, starting from income I \"\"\"\n",
    "    model = cls()\n",
    "    model.par.I = I\n",
    "    u0 = model.solve(do_print=False).u\n",
    "\n",
    "    T = tax_rate*I\n",
    "    model.par.I = I - T\n",
    "    u1 = model.solve(do_print=False).u\n",
    "\n",
    "    return (u0 - u1)/u0*100\n",
    "\n",
    "tax_rate = 0.02   # 2 percent of income, matching Section 4\n",
    "I_vec = np.linspace(3.2, 15, 30)   # I*(1-tax_rate) must stay above p1*x1_min=3\n",
    "\n",
    "loss_base = [utility_loss_pct(ConsumerClass, I, tax_rate) for I in I_vec]\n",
    "loss_sub  = [utility_loss_pct(SubsistenceConsumer, I, tax_rate) for I in I_vec]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7,5))\n",
    "ax.plot(I_vec, loss_base, label='baseline')\n",
    "ax.plot(I_vec, loss_sub, label='subsistence extension')\n",
    "ax.set_xlabel('income $I$ before tax')\n",
    "ax.set_ylabel('utility lost from a 2% lump-sum tax (%)')\n",
    "ax.set_title('Welfare cost of a 2% tax, by income level')\n",
    "ax.legend()\n",
    "plt.show()"
   ]
  },
