   "source": [
    "# Merging the two tables \n",
    "\n",
    "combined = pd.merge(\n",
    "    municip_gini.reset_index(),\n",
    "    municip_top10_share.reset_index(name='top10_share'),\n",
    "    on=['year', 'municipalities'],\n",
    "    how='inner'\n",
    ")\n",
    "\n",
    "combined = combined.sort_values(['municipalities', 'year']).reset_index(drop=True)\n",
    "\n",
    "display(combined)"
   ]
  },
